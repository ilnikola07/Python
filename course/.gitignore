cat << 'EOF' > .gitignore
# Игнорировать абсолютно всё по умолчанию
*

# Разрешить проход по всем папкам (иначе Git не заглянет внутрь них)
!*/

# Разрешить сам файл настроек Git и документацию (по желанию)
!.gitignore
!README.md

# Разрешить ТОЛЬКО файлы Python и Jupyter Notebook
!*.py
!*.ipynb

# Принудительно исключить системный мусор внутри разрешенных папок
venv/
.venv/
__pycache__/
.ipynb_checkpoints/
.vscode/
.idea/
EOF
