   <property name="styleSheet">
    <string notr="true">QTabWidget::pane {
    border: none;
    background-color: #2b5b84;
    top: 0px;
}

QTabWidget QStackedWidget &gt; QWidget {
    background-color: #2b5b84;
}

QTabBar::tab {
    background: #e0e0e0;
    color: #333333;
    min-width: 190px;
    height: 48px;
    font-size: 17px;
    font-weight: bold;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
}

QTabBar::tab:last {
    margin-right: 0px;
}

QTabBar::tab:selected {
    background-color: #2b5b84;
    color: white;
}

QTabBar::tab:hover:!selected {
    background-color: #d0d8e0;
}

QLabel {
    color: white;
    font-size: 17px;
    font-weight: bold;
}

QPushButton {
    background-color: #e0e0e0;
    color: #333333;
    min-height: 48px;
    font-size: 17px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    padding: 0px 16px;
}

QPushButton:hover {
    background-color: #d0d8e0;
}

QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: white;
    color: #222222;
    min-height: 40px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 6px;
